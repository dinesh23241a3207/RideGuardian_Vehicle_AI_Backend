# ============================================================
# RECOMMENDATION
# ============================================================

def get_recommendation(

    part: str,

    damage: str,

    part_confidence: float,

    damage_confidence: float

) -> str:

    if damage == "Broken part":

        return (

            f"A broken component was detected "
            f"on the {part}. Inspect the affected "
            f"component and repair or replace it "
            f"if required."

        )


    if damage == "Corrosion":

        return (

            f"Corrosion was detected on the "
            f"{part}. Inspect the affected area "
            f"and address the corrosion before "
            f"it progresses."

        )


    if damage == "Cracked":

        return (

            f"A crack was detected on the "
            f"{part}. Inspect the component "
            f"promptly for possible structural "
            f"or safety impact."

        )


    if damage == "Dent":

        return (

            f"A dent was detected on the "
            f"{part}. Inspect the component "
            f"for hidden damage and determine "
            f"whether repair is required."

        )


    if damage == "Scratch":

        return (

            f"A scratch was detected on the "
            f"{part}. Inspect the depth of "
            f"the scratch. Surface repair may "
            f"be sufficient for minor damage."

        )


    if damage == "Paint chip":

        return (

            f"Paint damage was detected on "
            f"the {part}. Surface repair is "
            f"recommended to reduce further "
            f"paint deterioration."

        )


    if damage == "Flaking":

        return (

            f"Surface flaking was detected "
            f"on the {part}. Inspect the affected "
            f"area for material or paint "
            f"deterioration."

        )


    if damage == "Missing part":

        return (

            f"A missing component was detected "
            f"on the {part}. Inspect the vehicle "
            f"and replace the missing component "
            f"if required."

        )


    return (

        f"The {part} shows a condition "
        f"classified as {damage}. Further "
        f"inspection is recommended."

    )


# ============================================================
# CONFIDENCE LEVEL
# ============================================================

def get_confidence_level(

    part_confidence: float,

    damage_confidence: float

) -> str:

    if (

        part_confidence >= 0.90

        and

        damage_confidence >= 0.90

    ):

        return "VERY HIGH"


    if (

        part_confidence >= 0.80

        and

        damage_confidence >= 0.80

    ):

        return "HIGH"


    if (

        part_confidence >= 0.60

        and

        damage_confidence >= 0.60

    ):

        return "MODERATE"


    return "LOW"
# ============================================================
# SERVICE BILL OCR
# ============================================================

def clean_ocr_text(text: str) -> str:
    """
    Clean OCR output while preserving useful bill information.
    """

    if not text:
        return ""

    lines = []

    for line in text.splitlines():

        line = line.strip()

        if not line:
            continue

        # Remove excessive spaces
        line = re.sub(
            r"[ \t]+",
            " ",
            line
        )

        lines.append(line)

    return "\n".join(lines)


# ============================================================
# EXTRACT DATE
# ============================================================

def extract_service_date(
    text: str
) -> str | None:

    patterns = [

        # DD/MM/YYYY
        r"\b\d{1,2}[/-]\d{1,2}[/-]\d{4}\b",

        # DD-MM-YY
        r"\b\d{1,2}[/-]\d{1,2}[/-]\d{2}\b",

        # YYYY-MM-DD
        r"\b\d{4}[/-]\d{1,2}[/-]\d{1,2}\b",

        # DD Month YYYY
        r"\b\d{1,2}\s+"
        r"(?:Jan|January|Feb|February|Mar|March|"
        r"Apr|April|May|Jun|June|Jul|July|"
        r"Aug|August|Sep|September|Oct|October|"
        r"Nov|November|Dec|December)"
        r"\s+\d{4}\b",
    ]

    for pattern in patterns:

        match = re.search(
            pattern,
            text,
            re.IGNORECASE
        )

        if match:

            return match.group(0)

    return None


# ============================================================
# EXTRACT ODOMETER
# ============================================================

def extract_odometer(
    text: str
) -> float | None:

    patterns = [

        r"(?:odometer|odo|kms?|km|mileage)"
        r"\s*[:#-]?\s*"
        r"(\d[\d,]*)",

    ]

    for pattern in patterns:

        match = re.search(
            pattern,
            text,
            re.IGNORECASE
        )

        if match:

            value = (
                match.group(1)
                .replace(",", "")
            )

            try:

                return float(value)

            except ValueError:

                pass

    return None


# ============================================================
# EXTRACT TOTAL COST
# ============================================================

def extract_total_cost(
    text: str
) -> float | None:

    patterns = [

        r"(?:grand total|net total|total amount|"
        r"total|amount payable|amount due)"
        r"\s*[:\-]?\s*"
        r"(?:₹|rs\.?|inr)?\s*"
        r"([\d,]+(?:\.\d{1,2})?)",

    ]

    for pattern in patterns:

        matches = re.findall(
            pattern,
            text,
            re.IGNORECASE
        )

        if matches:

            # Use the last matching total.
            value = matches[-1]

            value = value.replace(
                ",",
                ""
            )

            try:

                return float(value)

            except ValueError:

                pass

    return None


# ============================================================
# EXTRACT SERVICE TYPE
# ============================================================

def extract_service_type(
    text: str
) -> str | None:

    lower_text = text.lower()


    service_keywords = [

        "general service",
        "periodic service",
        "regular service",
        "oil service",
        "oil change",
        "first service",
        "second service",
        "third service",
        "major service",
        "minor service",
        "maintenance",
        "repair",

    ]


    for keyword in service_keywords:

        if keyword in lower_text:

            return keyword.title()


    return None


# ============================================================
# EXTRACT PARTS / WORK
# ============================================================

def extract_service_items(
    text: str
):

    items = []

    keywords = [

        "engine oil",
        "oil filter",
        "air filter",
        "brake pad",
        "brake oil",
        "coolant",
        "chain",
        "chain lube",
        "spark plug",
        "battery",
        "tyre",
        "tire",
        "clutch",
        "brake",
        "service",
        "inspection",
        "washing",
        "labour",
        "labor",

    ]


    for line in text.splitlines():

        clean_line = line.strip()

        if not clean_line:
            continue


        lower_line = clean_line.lower()


        for keyword in keywords:

            if keyword in lower_line:

                if clean_line not in items:

                    items.append(
                        clean_line
                    )

                break


    return items[:30]


# ============================================================
# SERVICE BILL OCR ANALYSIS
# ============================================================

def analyze_service_bill(
    image: Image.Image
) -> Dict[str, Any]:

    # --------------------------------------------------------
    # OCR
    # --------------------------------------------------------

    try:

        raw_text = pytesseract.image_to_string(
            image
        )

    except Exception as error:

        raise RuntimeError(
            "OCR engine failed. "
            f"{error}"
        )


    cleaned_text = clean_ocr_text(
        raw_text
    )


    if not cleaned_text:

        raise RuntimeError(
            "No readable text was detected "
            "in the service bill."
        )


    # --------------------------------------------------------
    # EXTRACT INFORMATION
    # --------------------------------------------------------

    service_date = extract_service_date(
        cleaned_text
    )


    odometer = extract_odometer(
        cleaned_text
    )


    total_cost = extract_total_cost(
        cleaned_text
    )


    service_type = extract_service_type(
        cleaned_text
    )


    service_items = extract_service_items(
        cleaned_text
    )


    # --------------------------------------------------------
    # RESULT
    # --------------------------------------------------------

    return {

        "success":
            True,

        "document_type":
            "service_bill",

        "service_date":
            service_date,

        "odometer_km":
            odometer,

        "service_type":
            service_type,

        "total_cost":
            total_cost,

        "service_items":
            service_items,

        "raw_text":
            cleaned_text,

    }


