# ============================================================
# VEHICLE PHOTO PREDICTION
# ============================================================

@router.post(
    "/predict/vehicle"
)
async def predict_vehicle(

    file: UploadFile = File(...)

) -> Dict[str, Any]:

    try:

        # ====================================================
        # CHECK FILE TYPE
        # ====================================================

        if not file.content_type:

            raise HTTPException(

                status_code=400,

                detail=
                    "Image content type is missing."

            )


        if not file.content_type.startswith(
            "image/"
        ):

            raise HTTPException(

                status_code=400,

                detail=
                    "Please upload an image."

            )


        # ====================================================
        # READ IMAGE
        # ====================================================

        image_bytes = (
            await file.read()
        )


        if not image_bytes:

            raise HTTPException(

                status_code=400,

                detail=
                    "Uploaded image is empty."

            )


        image = Image.open(

            BytesIO(
                image_bytes
            )

        ).convert(
            "RGB"
        )


        # ====================================================
        # PREPROCESS IMAGE
        # ====================================================

        image_tensor = transform(
            image
        )


        image_tensor = (
            image_tensor
            .unsqueeze(0)
            .to(DEVICE)
        )


        # ====================================================
        # VEHICLE PART PREDICTION
        # ====================================================

        with torch.no_grad():

            part_outputs = (
                part_model(
                    image_tensor
                )
            )


        # ====================================================
        # DAMAGE PREDICTION
        # ====================================================

        with torch.no_grad():

            damage_outputs = (
                damage_model(
                    image_tensor
                )
            )


        # ====================================================
        # SOFTMAX
        # ====================================================

        part_probabilities = (
            torch.softmax(
                part_outputs,
                dim=1
            )
        )


        damage_probabilities = (
            torch.softmax(
                damage_outputs,
                dim=1
            )
        )


        # ====================================================
        # PART RESULT
        # ====================================================

        (
            part_confidence_tensor,

            part_index_tensor

        ) = torch.max(

            part_probabilities,

            dim=1

        )


        part_index = (
            part_index_tensor.item()
        )


        part_confidence = (
            part_confidence_tensor.item()
        )


        if (

            part_index < 0

            or

            part_index >= len(
                part_classes
            )

        ):

            raise RuntimeError(
                "Vehicle part class index "
                "is outside class list."
            )


        part = (
            part_classes[
                part_index
            ]
        )


        # ====================================================
        # DAMAGE RESULT
        # ====================================================

        (
            damage_confidence_tensor,

            damage_index_tensor

        ) = torch.max(

            damage_probabilities,

            dim=1

        )


        damage_index = (
            damage_index_tensor.item()
        )


        damage_confidence = (
            damage_confidence_tensor.item()
        )


        if (

            damage_index < 0

            or

            damage_index >= len(
                damage_classes
            )

        ):

            raise RuntimeError(
                "Damage class index "
                "is outside class list."
            )


        damage = (
            damage_classes[
                damage_index
            ]
        )


        # ====================================================
        # TOP PART PREDICTIONS
        # ====================================================

        part_probs = (

            part_probabilities[0]

            .detach()

            .cpu()

            .tolist()

        )


        top_parts = sorted(

            enumerate(
                part_probs
            ),

            key=lambda x: x[1],

            reverse=True

        )[:5]


        top_part_results = []


        for (

            index,

            probability

        ) in top_parts:

            top_part_results.append({

                "class":
                    part_classes[index],

                "confidence":
                    round(
                        probability,
                        6
                    ),

                "confidence_percent":
                    round(
                        probability * 100,
                        2
                    )

            })


        # ====================================================
        # TOP DAMAGE PREDICTIONS
        # ====================================================

        damage_probs = (

            damage_probabilities[0]

            .detach()

            .cpu()

            .tolist()

        )


        top_damages = sorted(

            enumerate(
                damage_probs
            ),

            key=lambda x: x[1],

            reverse=True

        )[:5]


        top_damage_results = []


        for (

            index,

            probability

        ) in top_damages:

            top_damage_results.append({

                "class":
                    damage_classes[index],

                "confidence":
                    round(
                        probability,
                        6
                    ),

                "confidence_percent":
                    round(
                        probability * 100,
                        2
                    )

            })


        # ====================================================
        # COMBINED CONFIDENCE
        #
        # Part confidence × damage confidence
        # ====================================================

        combined_confidence = (

            part_confidence

            *

            damage_confidence

        )


        # ====================================================
        # CONFIDENCE LEVEL
        # ====================================================

        confidence_level = (
            get_confidence_level(

                part_confidence,

                damage_confidence

            )
        )


        # ====================================================
        # RECOMMENDATION
        # ====================================================

        recommendation = (
            get_recommendation(

                part,

                damage,

                part_confidence,

                damage_confidence

            )
        )


        # ====================================================
        # FINAL RESPONSE
        # ====================================================

        result = {

            "success":
                True,

            "model": {

                "part":
                    "CoAtNet",

                "damage":
                    "CoAtNet"

            },

            "affected_part":
                part,

            "part_confidence":
                round(
                    part_confidence,
                    6
                ),

            "part_confidence_percent":
                round(
                    part_confidence * 100,
                    2
                ),

            "detected_condition":
                damage,

            "damage_confidence":
                round(
                    damage_confidence,
                    6
                ),

            "damage_confidence_percent":
                round(
                    damage_confidence * 100,
                    2
                ),

            "combined_diagnosis":
                f"{part} — {damage}",

            "combined_confidence":
                round(
                    combined_confidence,
                    6
                ),

            "combined_confidence_percent":
                round(
                    combined_confidence * 100,
                    2
                ),

            "confidence_level":
                confidence_level,

            "recommendation":
                recommendation,

            "top_parts":
                top_part_results,

            "top_damages":
                top_damage_results

        }


        print()
        print(
            "=" * 60
        )

        print(
            "VEHICLE DIAGNOSIS"
        )

        print(
            "=" * 60
        )

        print(
            "PART:",
            part
        )

        print(
            "PART CONFIDENCE:",
            f"{part_confidence * 100:.2f}%"
        )

        print(
            "DAMAGE:",
            damage
        )

        print(
            "DAMAGE CONFIDENCE:",
            f"{damage_confidence * 100:.2f}%"
        )

        print(
            "COMBINED:",
            f"{part} — {damage}"
        )

        print(
            "COMBINED CONFIDENCE:",
            f"{combined_confidence * 100:.2f}%"
        )

        print(
            "=" * 60
        )


        return result


    # ========================================================
    # EXPECTED HTTP ERROR
    # ========================================================

    except HTTPException:

        raise


    # ========================================================
    # UNEXPECTED ERROR
    # ========================================================

    except Exception as error:

        print()
        print(
            "=" * 60
        )

        print(
            "VEHICLE AI ERROR"
        )

        print(
            "=" * 60
        )

        print(
            repr(error)
        )

        print(
            "=" * 60
        )


        raise HTTPException(

            status_code=500,

            detail=str(
                error
            )

        )


